def save_report_txt(result, filename="plagiarism_report.txt", input_method="text"):
    """Save the plagiarism report to a text file."""
    with open(filename, "w", encoding="utf-8") as f:
        f.write("PLAGIARISM DETECTION REPORT\n")
        f.write(f"Input method: {input_method}\n")
        f.write(f"Generated: {time.strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        f.write(f"Overall plagiarism: {result['plagiarism_percentage']}%\n")
        f.write(f"Total sentences: {result['total_sentences']}\n")
        f.write(f"Plagiarized sentences: {result['plagiarized_sentences']}\n")
        f.write(f"Verdict: {result['verdict']}\n\n")
        f.write("FLAGGED SENTENCES:\n")
        f.write("-" * 40 + "\n")
        for i, match in enumerate(result['matches'], 1):
            f.write(f"\n[{i}] Score: {match['similarity_score']}%\n")
            f.write(f"Pattern: {match['pattern']}\n")
