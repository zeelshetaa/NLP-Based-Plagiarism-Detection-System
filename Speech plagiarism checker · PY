class SpeechPlagiarismPipeline:
    """
    Complete pipeline:
    Speech/Text Input → Transcription → BERT Check → Report
    """

    def __init__(self, stt_engine="google", whisper_model="base", bert_threshold=0.75):
        """
        stt_engine: 'google' | 'whisper'
        whisper_model: 'tiny' | 'base' | 'small' | 'medium'
        bert_threshold: similarity cutoff (0.0–1.0)
        """
        self.bert_threshold = bert_threshold

        # Initialize STT
        if stt_engine == "whisper":
            self.stt = WhisperSTT(model_size=whisper_model)
        else:
            self.stt = GoogleSTT()
        self.stt_engine = stt_engine

        # Initialize BERT checker
        if NLP_AVAILABLE:
            self.checker = BERTPlagiarismChecker(threshold=bert_threshold)
        else:
            self.checker = None

    def run_from_speech(self, reference_text, duration=10, language="en-IN"):
        """
        Record speech → transcribe → check against reference text.
        reference_text: known source to compare against
        """
        print("\n[Pipeline] Starting speech input mode...")

        if self.stt_engine == "whisper":
            spoken_text = self.stt.record_and_transcribe(duration=duration)
        else:
            spoken_text = self.stt.listen_and_transcribe(
                language=language,
                phrase_limit=duration
            )

        if not spoken_text:
            print("[Pipeline] No speech captured. Exiting.")
            return None

        return self._run_check(spoken_text, reference_text, input_method="speech")

    def run_from_text(self, input_text, reference_text):
        """Check typed/pasted text against reference."""
        return self._run_check(input_text, reference_text, input_method="text")

    def run_from_pdf(self, pdf_path, reference_text):
        """Extract PDF text then check against reference."""
        print(f"[Pipeline] Extracting text from '{pdf_path}'...")
        input_text = extract_text_from_pdf(pdf_path)
        return self._run_check(input_text, reference_text, input_method="pdf")

    def _run_check(self, input_text, reference_text, input_method):
        """Internal: run BERT check and print report."""
        if not self.checker:
            print("[Pipeline] BERT checker not available. Install NLP libraries.")
            return None

        print(f"\n[Pipeline] Checking {len(input_text)} chars against reference...")
        result = self.checker.check_two_texts(input_text, reference_text)
        result["input_text"] = input_text

        print_report(result, input_method=input_method)
        save_report_txt(result, input_method=input_method)
        return result


