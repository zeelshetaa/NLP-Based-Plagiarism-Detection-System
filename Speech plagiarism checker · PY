# 3. BERT-BASED PLAGIARISM CHECKER
# =============================================================================

class BERTPlagiarismChecker:
    """
    Semantic plagiarism detection using Sentence-BERT embeddings
    and cosine similarity. Connects directly to your existing project logic.
    """

    def __init__(self, model_name="paraphrase-MiniLM-L6-v2", threshold=0.75):
        if not NLP_AVAILABLE:
            raise RuntimeError("Install: pip install sentence-transformers scikit-learn nltk")
        print(f"[BERT] Loading model '{model_name}'...")
        self.model = SentenceTransformer(model_name)
        self.threshold = threshold
        print("[BERT] Model loaded.")

    def get_embeddings(self, sentences):
        """Convert sentences to BERT embeddings."""
        return self.model.encode(sentences, convert_to_numpy=True)

    def check_two_texts(self, text1, text2):
        """
        Compare two texts for plagiarism.
        Returns dict with overall score and sentence-level matches.
        """
        sentences1 = split_into_sentences(preprocess_text(text1))
        sentences2 = split_into_sentences(preprocess_text(text2))

        if not sentences1 or not sentences2:
            return {"plagiarism_percentage": 0, "matches": [], "verdict": "No content to compare"}

        embeddings1 = self.get_embeddings(sentences1)
        embeddings2 = self.get_embeddings(sentences2)

        similarity_matrix = cosine_similarity(embeddings1, embeddings2)

        matches = []
        plagiarized_count = 0

        for i, sent1 in enumerate(sentences1):
            max_sim_idx = np.argmax(similarity_matrix[i])
            max_sim_score = float(similarity_matrix[i][max_sim_idx])

            if max_sim_score >= self.threshold:
                plagiarized_count += 1
                pattern = self._detect_pattern(sent1, sentences2[max_sim_idx])
                matches.append({
                    "your_sentence": sent1,
                    "matched_sentence": sentences2[max_sim_idx],
                    "similarity_score": round(max_sim_score * 100, 2),
                    "pattern": pattern,
                    "verdict": self._get_verdict(max_sim_score, pattern)
                })

        plagiarism_pct = round((plagiarized_count / len(sentences1)) * 100, 2)

        return {
            "plagiarism_percentage": plagiarism_pct,
            "total_sentences": len(sentences1),
            "plagiarized_sentences": plagiarized_count,
            "matches": matches,
            "verdict": self._overall_verdict(plagiarism_pct)
        }

    def _detect_pattern(self, sent1, sent2):
        """Classify the type of plagiarism pattern."""
        words1 = set(sent1.lower().split())
        words2 = set(sent2.lower().split())
        overlap = words1 & words2
        unique1 = words1 - words2
        unique2 = words2 - words1

        overlap_ratio = len(overlap) / max(len(words1), 1)

        if overlap_ratio > 0.7:
            return "direct_copy"
        elif len(unique1) > 3 and len(unique2) > 3 and overlap_ratio > 0.3:
            return "synonym_swap"
        elif overlap_ratio > 0.4:
            return "structural_reorder"
        else:
            return "deep_paraphrase"

    def _get_verdict(self, score, pattern):
        """Human-readable explanation for each match."""
        verdicts = {
            "direct_copy":       "High word overlap — likely direct copying.",
            "synonym_swap":      "Different words, same meaning — synonym-based paraphrase.",
            "structural_reorder":"Same content reordered — structural plagiarism.",
            "deep_paraphrase":   "Semantically identical — meaning-level paraphrase detected."
        }
        return verdicts.get(pattern, "Plagiarism detected.")

    def _overall_verdict(self, pct):
        if pct >= 70:
            return "HIGH plagiarism detected"
        elif pct >= 40:
            return "MODERATE plagiarism detected"
        elif pct >= 15:
            return "LOW plagiarism detected"
        else:
            return "Content appears original"


