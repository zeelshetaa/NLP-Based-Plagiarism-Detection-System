class WhisperSTT:
    """
    Offline speech-to-text using OpenAI Whisper.
    Best for: accuracy, Hindi support, no internet needed.
    Model sizes: tiny | base | small | medium | large
    """

    def __init__(self, model_size="base"):
        if not WHISPER_AVAILABLE:
            raise RuntimeError("Install openai-whisper: pip install openai-whisper")
        print(f"[Whisper] Loading '{model_size}' model...")
        self.model = whisper.load_model(model_size)
        self.sample_rate = 16000

    def record_audio(self, duration=10, output_path="recorded_audio.wav"):
        """Record audio from microphone and save as WAV."""
        if not SOUNDDEVICE_AVAILABLE:
            raise RuntimeError("Install sounddevice: pip install sounddevice scipy")

        print(f"[Whisper] Recording for {duration} seconds... Speak now!")
        audio_data = sd.rec(
            int(duration * self.sample_rate),
            samplerate=self.sample_rate,
            channels=1,
            dtype='int16'
        )
        sd.wait()
        wav_write(output_path, self.sample_rate, audio_data)
        print(f"[Whisper] Audio saved to '{output_path}'")
        return output_path

    def transcribe(self, audio_path, language=None):
        """
        Transcribe audio file to text.
        language: 'en' for English, 'hi' for Hindi, None for auto-detect
        """
        print("[Whisper] Transcribing...")
        options = {"language": language} if language else {}
        result = self.model.transcribe(audio_path, **options)
        text = result["text"].strip()
        print(f"[Whisper] Transcribed: {text}")
        return text

    def record_and_transcribe(self, duration=10, language=None):
        """One-step: record then transcribe."""
        audio_path = self.record_audio(duration=duration)
        return self.transcribe(audio_path, language=language)


class GoogleSTT:
    """
    Online speech-to-text using Google Speech Recognition API.
    Best for: quick demos, viva, internet available.
    Free tier available. Supports en-IN, hi-IN, gu-IN etc.
    """

    def __init__(self):
        if not SR_AVAILABLE:
            raise RuntimeError("Install SpeechRecognition: pip install SpeechRecognition pyaudio")
        self.recognizer = sr.Recognizer()

    def listen_and_transcribe(self, language="en-IN", timeout=10, phrase_limit=15):
        """
        Listen from microphone and transcribe using Google API.
        language: 'en-IN', 'hi-IN', 'gu-IN', 'en-US' etc.
        """
        with sr.Microphone() as source:
            print("[Google STT] Adjusting for ambient noise...")
            self.recognizer.adjust_for_ambient_noise(source, duration=1)
            print(f"[Google STT] Listening... (max {phrase_limit}s)")
            try:
                audio = self.recognizer.listen(
                    source,
                    timeout=timeout,
                    phrase_time_limit=phrase_limit
                )
            except sr.WaitTimeoutError:
                print("[Google STT] No speech detected within timeout.")
                return ""

        try:
            print("[Google STT] Transcribing via Google API...")
            text = self.recognizer.recognize_google(audio, language=language)
            print(f"[Google STT] Transcribed: {text}")
            return text
        except sr.UnknownValueError:
            print("[Google STT] Could not understand audio.")
            return ""
        except sr.RequestError as e:
            print(f"[Google STT] API error: {e}")
            return ""

    def transcribe_file(self, audio_path, language="en-IN"):
        """Transcribe an existing WAV audio file."""
        with sr.AudioFile(audio_path) as source:
            audio = self.recognizer.record(source)
        try:
            return self.recognizer.recognize_google(audio, language=language)
        except (sr.UnknownValueError, sr.RequestError) as e:
            print(f"[Google STT] Error: {e}")
            return ""


